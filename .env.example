# Vultr Serverless Inference key: the submission provider.
VULTR_INFERENCE_API_KEY=
# Vultr model. Empty: deepseek-v4.1-flash-1017
VULTR_INFERENCE_MODEL=
# Runner runtime. Empty: Docker's default runtime (runc on most installations); runc; runsc etc
SANDBOX_RUNTIME=
# Groq key, for local development only.
GROQ_API_KEY=
# vultr or groq. Empty: vultr if its key is set, else groq if its key is set, else the built-in planner.
LLM_PROVIDER=
# Overrides the provider's default model (Groq default: openai/gpt-oss-120b).
LLM_MODEL=
# Groq gpt-oss models only: low, medium or high. Empty: low for planning, medium for code.
LLM_REASONING_EFFORT=
# true: allow only vultr, and refuse to start without VULTR_INFERENCE_API_KEY.
REQUIRE_VULTR=
# Token budget for model-written scripts (reasoning plus code). Empty: 3000
LLM_CODE_MAX_TOKENS=
# Bind address. Empty: 127.0.0.1 (use 0.0.0.0 only inside a container or behind a firewall).
HOST=
# Port. Empty: 8080
PORT=
# true only behind a reverse proxy that sets X-Forwarded-For (e.g. Caddy).
TRUST_PROXY=
# A single cross-origin site allowed to call the API. Empty: same-origin only.
ALLOWED_ORIGIN=
# Approved runs executing at once. Empty: 2
MAX_CONCURRENT_RUNS=
# Plans per minute per client IP (all limited requests: twice this). Empty: 10
RATE_LIMIT_PER_MIN=
# Model calls per UTC day. Empty: 300
MAX_LLM_CALLS_PER_DAY=
