# Copy to /etc/slipstream.env (root:root, chmod 600) and fill in the two Vultr values.
# Do not copy a GROQ_API_KEY here: Groq is for local development only.
# Vultr Serverless Inference API key.
VULTR_INFERENCE_API_KEY=
# Vultr inference model. Empty: deepseek-v4.1-flash-1017
VULTR_INFERENCE_MODEL=
# The only provider allowed on the submission deployment.
LLM_PROVIDER=vultr
# Required for the submission: refuse any other provider and refuse to start without the Vultr key.
REQUIRE_VULTR=true
# Run sandboxes under gVisor (installed by deploy/setup.sh).
SANDBOX_RUNTIME=runsc
# Listen on loopback only; Caddy is the public entry point.
HOST=127.0.0.1
# Must match the reverse_proxy port in the Caddyfile.
PORT=8080
# Read the client IP from X-Forwarded-For, which Caddy sets. Only true behind a proxy.
TRUST_PROXY=true
# Approved runs executing at once; extra approvals get HTTP 429.
MAX_CONCURRENT_RUNS=2
# Plans per minute per client IP; plan, red team and approve requests together get twice this.
RATE_LIMIT_PER_MIN=10
# Model calls per UTC day across all users; after that, plans use the built-in planner.
MAX_LLM_CALLS_PER_DAY=300
